# ============================================================
# Bureaucracy AI — Environment Variables Reference
# Copy this file to .env and fill in your values.
# ============================================================

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# --- Embedding Model (HuggingFace, runs locally) ---
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384

# --- RAG Configuration ---
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.60
RAG_MAX_CONTEXT_CHARS=6000
RAG_KEYWORD_TOP_K=10

# --- Database (leave empty to use default: data/database/bureaucracy_ai.db) ---
DATABASE_URL=

# --- File Uploads ---
# Leave empty to use default: data/uploads/
UPLOADS_DIR=
MAX_UPLOAD_SIZE_MB=15

# --- Reports ---
# Leave empty to use default: data/reports/
REPORTS_DIR=

# --- OCR (Tesseract) ---
# Leave empty if Tesseract is on your PATH.
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Security ---
# Change this before deploying anywhere accessible from the internet.
ADMIN_API_KEY=admin_change_me_before_production

# --- Logging ---
LOG_LEVEL=INFO

# --- HuggingFace Offline Mode ---
# Set to 1 when running without internet access to avoid retry delays.
# The model must already be cached in the venv.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
